# Load explicitly: set -a; . ./.env; set +a
KNOWLEDGE_DATABASE_URL="dbname=knowledge host=127.0.0.1 port=5432 user=knowledge"
KNOWLEDGE_TEST_DATABASE_URL="dbname=knowledge_test host=127.0.0.1 port=5432 user=knowledge"
KNOWLEDGE_ARCHIVE_ROOT="./.local/archive"
KNOWLEDGE_ZOTERO_URL="http://127.0.0.1:23119"
# Write access to Zotero is needed for import, never commit a real key.
KNOWLEDGE_ZOTERO_API_KEY=""
# Optional overrides; defaults use the current home directory or PATH.
# KNOWLEDGE_HERMES_PYTHON="/absolute/path/to/hermes/venv/bin/python"
# KNOWLEDGE_POSTGRES_BIN="/usr/lib/postgresql/18/bin"
# Required only for the backup command; Zotero must use knowledge-zotero.service.
# KNOWLEDGE_ZOTERO_LIBRARY="/absolute/path/to/zotero-library"
# Required only for the historical ten-document pilot preset.
# KNOWLEDGE_PILOT_SOURCE_DIRECTORY="/absolute/path/to/pilot-pdfs"

# Optional default for CLI and web; existing installations can keep their batch.
KNOWLEDGE_DEFAULT_BATCH="default"
